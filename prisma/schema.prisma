generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  OWNER
  ADMIN
}

model Property {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  address   String?  @db.VarChar(500)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  users     User[]
  rooms     Room[]
  auditLogs AuditLog[]
  residents Resident[]
  occupancies Occupancy[]
  charges Charge[]
  payments Payment[]
  applications RentalApplication[]
  @@map("properties")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  propertyId   String   @map("property_id") @db.Uuid
  phone        String   @unique @db.VarChar(16)
  fullName     String   @map("full_name") @db.VarChar(160)
  passwordHash String   @map("password_hash")
  role         Role     @default(ADMIN)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  sessions     Session[]
  auditLogs    AuditLog[]
  occupancies  Occupancy[]
  payments Payment[]
  charges Charge[]
  permissions UserPermission[]
  @@unique([id, propertyId])
  @@index([propertyId])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Room {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  number     String   @db.VarChar(20)
  capacity   Int
  version    Int      @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  beds       Bed[]
  occupancies Occupancy[]
  charges Charge[]
  @@unique([id, propertyId])
  @@unique([propertyId, number])
  @@map("rooms")
}

model Bed {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  number    String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  occupancies Occupancy[]
  charges Charge[]
  @@unique([id, roomId])
  // ACTIVE Occupancy determines OCCUPIED.
  @@unique([roomId, number])
  @@map("beds")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(80)
  entity     String   @db.VarChar(40)
  entityId   String   @map("entity_id") @db.Uuid
  metadata   Json
  createdAt  DateTime @default(now()) @map("created_at")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([propertyId, createdAt])
  @@map("audit_logs")
}

model RateBucket {
  key       String   @id @db.Char(64)
  attempts  Int      @default(1)
  expiresAt DateTime @map("expires_at")
  @@index([expiresAt])
  @@map("rate_buckets")
}

enum OccupancyStatus {
  ACTIVE
  CLOSED
}

enum ChargeStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  @@map("charge_status")
}

enum ChargeType {
  RENT
  DEPOSIT
  PENALTY
  UTILITIES
  OTHER
  @@map("charge_type")
}

enum PaymentMethod {
  CASH
  CARD_TRANSFER
  BANK_TRANSFER
  OTHER
  @@map("payment_method")
}

model Charge {
  id String @id @default(uuid()) @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  residentId String @map("resident_id") @db.Uuid
  roomId String @map("room_id") @db.Uuid
  bedId String @map("bed_id") @db.Uuid
  amount Decimal @db.Decimal(10, 2)
  paidAmount Decimal @default(dbgenerated("0")) @map("paid_amount") @db.Decimal(10, 2)
  // GENERATED ALWAYS in SQL migration. Never supplied on create/update.
  dueAmount Decimal @default(dbgenerated()) @map("due_amount") @db.Decimal(10, 2)
  type ChargeType @default(RENT)
  status ChargeStatus @default(dbgenerated("'UNPAID'::charge_status"))
  billingPeriodStart DateTime @map("billing_period_start") @db.Date
  billingPeriodEnd DateTime @map("billing_period_end") @db.Date
  dueDate DateTime @map("due_date") @db.Date
  gracePeriodDays Int @default(0) @map("grace_period_days")
  idempotencyKey String @map("idempotency_key") @db.Uuid
  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  property Property @relation(fields:[propertyId], references:[id], onDelete:Restrict)
  resident Resident @relation(fields:[residentId,propertyId], references:[id,propertyId], onDelete:Restrict, onUpdate:Restrict)
  room Room @relation(fields:[roomId,propertyId], references:[id,propertyId], onDelete:Restrict, onUpdate:Restrict)
  bed Bed @relation(fields:[bedId,roomId], references:[id,roomId], onDelete:Restrict, onUpdate:Restrict)
  creator User @relation(fields:[createdByUserId,propertyId], references:[id,propertyId], onDelete:Restrict, onUpdate:Restrict)
  payments Payment[]
  @@unique([id,residentId,propertyId])
  allocations PaymentAllocation[]
  @@unique([propertyId,idempotencyKey])
  @@index([propertyId,dueDate])
  @@index([residentId,createdAt])
  @@map("charges")
}

model Payment {
  id String @id @default(uuid()) @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  chargeId String? @map("charge_id") @db.Uuid
  residentId String @map("resident_id") @db.Uuid
  amount Decimal @db.Decimal(10, 2)
  method PaymentMethod @default(CASH)
  comment String? @db.VarChar(2000)
  createdByUserId String @map("created_by_user_id") @db.Uuid
  idempotencyKey String @map("idempotency_key") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  property Property @relation(fields:[propertyId], references:[id], onDelete:Restrict)
  charge Charge? @relation(fields:[chargeId,residentId,propertyId], references:[id,residentId,propertyId], onDelete:Restrict, onUpdate:Restrict)
  resident Resident @relation(fields:[residentId,propertyId], references:[id,propertyId], onDelete:Restrict, onUpdate:Restrict)
  creator User @relation(fields:[createdByUserId,propertyId], references:[id,propertyId], onDelete:Restrict, onUpdate:Restrict)
  @@unique([propertyId,idempotencyKey])
  @@index([chargeId])
  @@unique([id,residentId,propertyId])
  allocations PaymentAllocation[]
  @@index([residentId,createdAt])
  @@index([propertyId,createdAt])
  @@map("payments")
}

model PaymentAllocation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  residentId String @map("resident_id") @db.Uuid
  paymentId String @map("payment_id") @db.Uuid
  chargeId String @map("charge_id") @db.Uuid
  amount Decimal @db.Decimal(10,2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  payment Payment @relation(fields:[paymentId,residentId,propertyId],references:[id,residentId,propertyId],onDelete:Restrict,onUpdate:Restrict)
  charge Charge @relation(fields:[chargeId,residentId,propertyId],references:[id,residentId,propertyId],onDelete:Restrict,onUpdate:Restrict)
  @@unique([paymentId,chargeId])
  @@index([chargeId])
  @@index([propertyId,residentId])
  @@map("payment_allocations")
}

model Resident {
  id String @id @default(uuid()) @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  fullName String @map("full_name") @db.VarChar(160)
  phone String @db.VarChar(16)
  photoUrl String? @map("photo_url") @db.VarChar(500)
  note String? @db.VarChar(2000)
  totalDebt Decimal @default(dbgenerated("0")) @map("total_debt") @db.Decimal(18, 2)
  creditBalance Decimal @default(dbgenerated("0")) @map("credit_balance") @db.Decimal(18, 2)
  accessGranted Boolean @default(dbgenerated("true")) @map("access_granted")
  accessStatusReason String @default(dbgenerated("'OK'::character varying")) @map("access_status_reason") @db.VarChar(255)
  financeCheckedAt DateTime? @map("finance_checked_at") @db.Timestamptz(3)
  applications RentalApplication[]
  charges Charge[]
  payments Payment[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  occupancies Occupancy[]
  @@unique([propertyId, phone])
  @@unique([id, propertyId])
  @@map("residents")
}

model Occupancy {
  id String @id @default(uuid()) @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  residentId String @map("resident_id") @db.Uuid
  roomId String @map("room_id") @db.Uuid
  bedId String @map("bed_id") @db.Uuid
  moveInDate DateTime @map("move_in_date") @db.Date
  moveOutDate DateTime? @map("move_out_date") @db.Date
  monthlyPrice Decimal @map("monthly_price") @db.Decimal(14, 2)
  paymentDay Int @map("payment_day")
  depositAmount Decimal @map("deposit_amount") @db.Decimal(14, 2)
  status OccupancyStatus @default(ACTIVE)
  createdBy String @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  resident Resident @relation(fields: [residentId, propertyId], references: [id, propertyId], onDelete: Restrict, onUpdate: Restrict)
  room Room @relation(fields: [roomId, propertyId], references: [id, propertyId], onDelete: Restrict, onUpdate: Restrict)
  bed Bed @relation(fields: [bedId, roomId], references: [id, roomId], onDelete: Restrict, onUpdate: Restrict)
  creator User @relation(fields: [createdBy, propertyId], references: [id, propertyId], onDelete: Restrict, onUpdate: Restrict)
  // Partial unique indexes for ACTIVE bed/resident live in the SQL migration (Prisma 6).
  @@index([propertyId, status])
  @@index([residentId, moveInDate])
  @@index([bedId, moveInDate])
  @@map("occupancies")
}


enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFO
  APPROVED
  REJECTED
  CANCELLED
  CONVERTED_TO_RESIDENT
}
enum ApplicationChannel {
  WEB
  TELEGRAM
}
enum DocumentKind {
  PASSPORT_FRONT
  PASSPORT_BACK
  FACE
}
model Permission {
  code String @id @db.VarChar(80)
  users UserPermission[]
  @@map("permissions")
}
model UserPermission {
  userId String @map("user_id") @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  permissionCode String @map("permission_code") @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields:[userId,propertyId],references:[id,propertyId],onDelete:Restrict,onUpdate:Restrict)
  permission Permission @relation(fields:[permissionCode],references:[code],onDelete:Restrict)
  @@id([userId,permissionCode])
  @@map("user_permissions")
}
model RentalApplication {
  id String @id @default(uuid()) @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  status ApplicationStatus @default(DRAFT)
  channel ApplicationChannel @default(WEB)
  version Int @default(1)
  profileCipher String @map("profile_cipher")
  phoneHash String @map("phone_hash") @db.Char(64)
  pinflHash String? @map("pinfl_hash") @db.Char(64)
  passportHash String? @map("passport_hash") @db.Char(64)
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(3)
  phoneVerificationMethod String? @map("phone_verification_method") @db.VarChar(40)
  residentId String? @map("resident_id") @db.Uuid
  occupancyId String? @unique @map("occupancy_id") @db.Uuid
  feedbackCipher String? @map("feedback_cipher")
  duplicateReviewCipher String? @map("duplicate_review_cipher")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(3)
  approvedAt DateTime? @map("approved_at") @db.Timestamptz(3)
  rejectedAt DateTime? @map("rejected_at") @db.Timestamptz(3)
  convertedAt DateTime? @map("converted_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  retentionPolicy String @default("MANUAL_REVIEW") @map("retention_policy")
  property Property @relation(fields:[propertyId],references:[id],onDelete:Restrict)
  resident Resident? @relation(fields:[residentId,propertyId],references:[id,propertyId],onDelete:Restrict,onUpdate:Restrict)
  documents ApplicationDocument[]
  history ApplicationStatusHistory[]
  sessions ApplicantSession[]
  challenges PhoneChallenge[]
  biometricSource BiometricEnrollmentSource?
  @@unique([id,propertyId])
  @@index([propertyId,status,createdAt])
  @@index([propertyId,phoneHash])
  @@index([propertyId,pinflHash])
  @@index([propertyId,passportHash])
  @@map("rental_applications")
}
model ApplicantSession {
  id String @id @default(uuid()) @db.Uuid
  applicationId String @map("application_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  application RentalApplication @relation(fields:[applicationId],references:[id],onDelete:Restrict)
  @@index([expiresAt])
  @@map("applicant_sessions")
}
model PhoneChallenge {
  id String @id @default(uuid()) @db.Uuid
  applicationId String @map("application_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.Char(64)
  telegramUserId String? @map("telegram_user_id") @db.VarChar(30)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  application RentalApplication @relation(fields:[applicationId],references:[id],onDelete:Restrict)
  @@index([telegramUserId,expiresAt])
  @@map("phone_challenges")
}
model ApplicationDocument {
  id String @id @default(uuid()) @db.Uuid
  applicationId String @map("application_id") @db.Uuid
  kind DocumentKind
  storageKey String @map("storage_key") @db.VarChar(200)
  contentHash String @map("content_hash") @db.Char(64)
  mimeType String @map("mime_type") @db.VarChar(40)
  size Int
  width Int
  height Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  application RentalApplication @relation(fields:[applicationId],references:[id],onDelete:Restrict)
  biometricSource BiometricEnrollmentSource?
  @@unique([applicationId,kind])
  @@map("application_documents")
}
model BiometricEnrollmentSource {
  id String @id @default(uuid()) @db.Uuid
  applicationId String @unique @map("application_id") @db.Uuid
  documentId String @unique @map("document_id") @db.Uuid
  purpose String @default("BIOMETRIC_ENROLLMENT_SOURCE")
  qualityReview String @default("MANUAL_REQUIRED") @map("quality_review")
  application RentalApplication @relation(fields:[applicationId],references:[id],onDelete:Restrict)
  document ApplicationDocument @relation(fields:[documentId],references:[id],onDelete:Restrict)
  @@map("biometric_enrollment_sources")
}
model ApplicationStatusHistory {
  id String @id @default(uuid()) @db.Uuid
  applicationId String @map("application_id") @db.Uuid
  fromStatus ApplicationStatus? @map("from_status")
  toStatus ApplicationStatus @map("to_status")
  actorId String? @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  application RentalApplication @relation(fields:[applicationId],references:[id],onDelete:Restrict)
  @@index([applicationId,createdAt])
  @@map("application_status_history")
}

model TelegramCursor {
  id String @id
  lastUpdateId Int @default(0) @map("last_update_id")
  @@map("telegram_cursors")
}
