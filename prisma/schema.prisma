generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
}

model Property {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  address   String?  @db.VarChar(500)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  users     User[]
  rooms     Room[]
  auditLogs AuditLog[]
  residents Resident[]
  occupancies Occupancy[]
  charges Charge[]
  payments Payment[]
  @@map("properties")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  propertyId   String   @map("property_id") @db.Uuid
  phone        String   @unique @db.VarChar(16)
  fullName     String   @map("full_name") @db.VarChar(160)
  passwordHash String   @map("password_hash")
  role         Role     @default(ADMIN)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  sessions     Session[]
  auditLogs    AuditLog[]
  occupancies  Occupancy[]
  payments Payment[]
  charges Charge[]
  @@unique([id, propertyId])
  @@index([propertyId])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Room {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  number     String   @db.VarChar(20)
  capacity   Int
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  beds       Bed[]
  occupancies Occupancy[]
  charges Charge[]
  @@unique([id, propertyId])
  @@unique([propertyId, number])
  @@map("rooms")
}

model Bed {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  number    String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  occupancies Occupancy[]
  charges Charge[]
  @@unique([id, roomId])
  // ACTIVE Occupancy determines OCCUPIED.
  @@unique([roomId, number])
  @@map("beds")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String   @db.VarChar(80)
  entity     String   @db.VarChar(40)
  entityId   String   @map("entity_id") @db.Uuid
  metadata   Json
  createdAt  DateTime @default(now()) @map("created_at")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([propertyId, createdAt])
  @@map("audit_logs")
}

model RateBucket {
  key       String   @id @db.Char(64)
  attempts  Int      @default(1)
  expiresAt DateTime @map("expires_at")
  @@index([expiresAt])
  @@map("rate_buckets")
}

enum OccupancyStatus {
  ACTIVE
  CLOSED
}

enum ChargeStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  @@map("charge_status")
}

enum ChargeType {
  RENT
  DEPOSIT
  PENALTY
  UTILITIES
  OTHER
  @@map("charge_type")
}

enum PaymentMethod {
  CASH
  CARD_TRANSFER
  BANK_TRANSFER
  OTHER
  @@map("payment_method")
}

model Charge {
  id String @id @default(uuid()) @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  residentId String @map("resident_id") @db.Uuid
  roomId String @map("room_id") @db.Uuid
  bedId String @map("bed_id") @db.Uuid
  amount Decimal @db.Decimal(10, 2)
  paidAmount Decimal @default(dbgenerated("0")) @map("paid_amount") @db.Decimal(10, 2)
  // GENERATED ALWAYS in SQL migration. Never supplied on create/update.
  dueAmount Decimal @default(dbgenerated()) @map("due_amount") @db.Decimal(10, 2)
  type ChargeType @default(RENT)
  status ChargeStatus @default(dbgenerated("'UNPAID'::charge_status"))
  billingPeriodStart DateTime @map("billing_period_start") @db.Date
  billingPeriodEnd DateTime @map("billing_period_end") @db.Date
  dueDate DateTime @map("due_date") @db.Date
  gracePeriodDays Int @default(0) @map("grace_period_days")
  idempotencyKey String @map("idempotency_key") @db.Uuid
  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  property Property @relation(fields:[propertyId], references:[id], onDelete:Restrict)
  resident Resident @relation(fields:[residentId,propertyId], references:[id,propertyId], onDelete:Restrict, onUpdate:Restrict)
  room Room @relation(fields:[roomId,propertyId], references:[id,propertyId], onDelete:Restrict, onUpdate:Restrict)
  bed Bed @relation(fields:[bedId,roomId], references:[id,roomId], onDelete:Restrict, onUpdate:Restrict)
  creator User @relation(fields:[createdByUserId,propertyId], references:[id,propertyId], onDelete:Restrict, onUpdate:Restrict)
  payments Payment[]
  @@unique([id,residentId,propertyId])
  allocations PaymentAllocation[]
  @@unique([propertyId,idempotencyKey])
  @@index([propertyId,dueDate])
  @@index([residentId,createdAt])
  @@map("charges")
}

model Payment {
  id String @id @default(uuid()) @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  chargeId String? @map("charge_id") @db.Uuid
  residentId String @map("resident_id") @db.Uuid
  amount Decimal @db.Decimal(10, 2)
  method PaymentMethod @default(CASH)
  comment String? @db.VarChar(2000)
  createdByUserId String @map("created_by_user_id") @db.Uuid
  idempotencyKey String @map("idempotency_key") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  property Property @relation(fields:[propertyId], references:[id], onDelete:Restrict)
  charge Charge? @relation(fields:[chargeId,residentId,propertyId], references:[id,residentId,propertyId], onDelete:Restrict, onUpdate:Restrict)
  resident Resident @relation(fields:[residentId,propertyId], references:[id,propertyId], onDelete:Restrict, onUpdate:Restrict)
  creator User @relation(fields:[createdByUserId,propertyId], references:[id,propertyId], onDelete:Restrict, onUpdate:Restrict)
  @@unique([propertyId,idempotencyKey])
  @@index([chargeId])
  @@unique([id,residentId,propertyId])
  allocations PaymentAllocation[]
  @@index([residentId,createdAt])
  @@index([propertyId,createdAt])
  @@map("payments")
}

model PaymentAllocation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  residentId String @map("resident_id") @db.Uuid
  paymentId String @map("payment_id") @db.Uuid
  chargeId String @map("charge_id") @db.Uuid
  amount Decimal @db.Decimal(10,2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  payment Payment @relation(fields:[paymentId,residentId,propertyId],references:[id,residentId,propertyId],onDelete:Restrict,onUpdate:Restrict)
  charge Charge @relation(fields:[chargeId,residentId,propertyId],references:[id,residentId,propertyId],onDelete:Restrict,onUpdate:Restrict)
  @@unique([paymentId,chargeId])
  @@index([chargeId])
  @@index([propertyId,residentId])
  @@map("payment_allocations")
}

model Resident {
  id String @id @default(uuid()) @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  fullName String @map("full_name") @db.VarChar(160)
  phone String @db.VarChar(16)
  photoUrl String? @map("photo_url") @db.VarChar(500)
  note String? @db.VarChar(2000)
  totalDebt Decimal @default(dbgenerated("0")) @map("total_debt") @db.Decimal(18, 2)
  creditBalance Decimal @default(dbgenerated("0")) @map("credit_balance") @db.Decimal(18, 2)
  accessGranted Boolean @default(dbgenerated("true")) @map("access_granted")
  accessStatusReason String @default(dbgenerated("'OK'::character varying")) @map("access_status_reason") @db.VarChar(255)
  financeCheckedAt DateTime? @map("finance_checked_at") @db.Timestamptz(3)
  charges Charge[]
  payments Payment[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  occupancies Occupancy[]
  @@unique([propertyId, phone])
  @@unique([id, propertyId])
  @@map("residents")
}

model Occupancy {
  id String @id @default(uuid()) @db.Uuid
  propertyId String @map("property_id") @db.Uuid
  residentId String @map("resident_id") @db.Uuid
  roomId String @map("room_id") @db.Uuid
  bedId String @map("bed_id") @db.Uuid
  moveInDate DateTime @map("move_in_date") @db.Date
  moveOutDate DateTime? @map("move_out_date") @db.Date
  monthlyPrice Decimal @map("monthly_price") @db.Decimal(14, 2)
  paymentDay Int @map("payment_day")
  depositAmount Decimal @map("deposit_amount") @db.Decimal(14, 2)
  status OccupancyStatus @default(ACTIVE)
  createdBy String @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  resident Resident @relation(fields: [residentId, propertyId], references: [id, propertyId], onDelete: Restrict, onUpdate: Restrict)
  room Room @relation(fields: [roomId, propertyId], references: [id, propertyId], onDelete: Restrict, onUpdate: Restrict)
  bed Bed @relation(fields: [bedId, roomId], references: [id, roomId], onDelete: Restrict, onUpdate: Restrict)
  creator User @relation(fields: [createdBy, propertyId], references: [id, propertyId], onDelete: Restrict, onUpdate: Restrict)
  // Partial unique indexes for ACTIVE bed/resident live in the SQL migration (Prisma 6).
  @@index([propertyId, status])
  @@index([residentId, moveInDate])
  @@index([bedId, moveInDate])
  @@map("occupancies")
}
