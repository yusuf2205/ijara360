# Copy to .env for LOCAL development. Generate independent production secrets.
DATABASE_URL=postgresql://ijara360:change-this-local-password@127.0.0.1:55436/ijara360_dev?schema=public
APP_ORIGIN=http://localhost:3000
PORT=4000
NODE_ENV=development
SETUP_TOKEN=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
# M4 applications: `openssl rand -hex 32`; absolute directory outside the repository.
KYC_ENCRYPTION_KEY=replace-with-64-hex-characters
KYC_STORAGE_PATH=C:/ijara360-dev/kyc
# Optional: Telegram phone verification (polling needs no public webhook).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=polling
# Explicit demo-only credentials (db:demo refuses NODE_ENV=production).
DEMO_SEED=false
DEMO_OWNER_PHONE=+998900000001
DEMO_OWNER_PASSWORD=replace-with-a-strong-demo-password
