{
    auto_https disable_redirects
    default_sni 192.168.1.105
    # Loopback-only listeners sit behind Tailscale Serve/Funnel on the NAS host: keep the
    # client address it forwards. The LAN listener (:443) stays untrusted, so Caddy
    # replaces any client-supplied X-Forwarded-For with the real LAN address.
    servers :8080 {
        trusted_proxies static private_ranges
    }
    servers :8081 {
        trusted_proxies static private_ranges
    }
}
(security_headers) {
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
    }
}
(application) {
    # Private listeners (LAN, tailnet): overwrite whatever the client sent.
    request_header X-Ijara-Channel private
    encode zstd gzip
    handle /api/* {
        reverse_proxy api:4000
    }
    handle {
        reverse_proxy web:3000
    }
    import security_headers
}
https://192.168.1.105 {
    tls internal
    import application
}
# Only published on NAS loopback, behind Tailscale Serve HTTPS (tailnet only).
http://:8080 {
    import application
}
# Public surface, only published on NAS loopback behind Tailscale Funnel HTTPS (internet).
# Serves the whole site; the API learns the request came from the internet and asks staff on a new
# device to confirm the login in Telegram. The bot webhook and health check stay private.
http://:8081 {
    request_header X-Ijara-Channel public
    encode zstd gzip
    handle /api/telegram/* {
        respond "Not found" 404
    }
    handle /api/health {
        respond "Not found" 404
    }
    handle /api/* {
        reverse_proxy api:4000
    }
    handle {
        reverse_proxy web:3000
    }
    import security_headers
    header Strict-Transport-Security "max-age=31536000"
}
