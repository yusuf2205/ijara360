# Private NAS file: /volume1/docker/ijara360/secrets/production.env, mode 600.
# Use independent random hexadecimal passwords, not these placeholders.
POSTGRES_PASSWORD=replace_with_random_hex_password
APP_DB_PASSWORD=replace_with_independent_random_hex_password
SETUP_TOKEN=replace_with_at_least_32_random_characters
APP_ORIGIN=https://192.168.1.105:8446
ADDITIONAL_APP_ORIGINS=https://mynas.tail4bf75c.ts.net:8446
IJARA_ROOT=/volume1/docker/ijara360
# M4 applications: generate once with `openssl rand -hex 32` and keep an offline copy.
# Never rotate by editing: existing profiles and documents can only be opened with this key.
KYC_ENCRYPTION_KEY=replace_with_64_hex_characters
# Optional: only if more than one active property exists (defaults to the oldest one).
APPLICATION_PROPERTY_ID=
# Optional: address applicants open from the Telegram button (defaults to APP_ORIGIN).
PUBLIC_APP_ORIGIN=
# Optional until phone verification is enabled. Token from @BotFather; username without @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=polling
RELEASE_TAG=local

# M7 geolocation (docs/M7-LOCATION.md).
# Yandex Maps JS API key, restricted to the site's domains in the Yandex developer console. Showing people's
# positions in real time needs a COMMERCIAL licence (free terms, clause 5.1.3); leave empty until then.
YANDEX_MAPS_API_KEY=
# Status thresholds (seconds) and history retention (days).
LOCATION_LIVE_SECONDS=180
LOCATION_STALE_SECONDS=2100
LOCATION_HISTORY_RETENTION_DAYS=30
# M7.1 own domain through Cloudflare Tunnel (docs/M7.1-DOMAIN.md). Set by scripts/configure-domain.sh only
# after a live check; the tunnel container starts only when the token is present.
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_DOMAIN=ijara360.uz
WATCH_DOMAIN=
